# Bountybot Triage Room — server environment.
# Copy to .env (or export in your hosting panel). NEVER commit a filled copy.

# From the Nexconn Console (App Key management page). The App Key is also
# shown to browsers; the App Secret must exist ONLY here, on the server.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=

# Data center of your Nexconn app: sg (default) | us | sau
NEXCONN_DC=sg

# Backend port
PORT=8787
